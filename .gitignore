# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual Environment
venv/
.venv/
env/

# Environment Variables (SECRETS - NEVER COMMIT)
.env
.env.local
.env.production

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS Files
.DS_Store
Thumbs.db

# Data files (too large for GitHub)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# MLflow artifacts (tracked by MLflow, not Git)
mlflow/
mlruns/

# Docker volumes
postgres_data/

# Logs
logs/
*.log

# Jupyter checkpoints
.ipynb_checkpoints/

# Test coverage
htmlcov/
.coverage
.pytest_cache/

# ChromaDB local storage
chroma_data/
